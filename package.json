{
  "name": "wemedia-buddy",
  "productName": "WeMediaBuddy",
  "version": "0.2.0",
  "private": true,
  "description": "A local desktop terminal for human and external-Agent self-media operations.",
  "main": ".vite/build/index.js",
  "scripts": {
    "prestart": "node scripts/check-dev-port.mjs",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check:capabilities": "node scripts/check-capability-registry.mjs",
    "build": "node scripts/prepare-pi-runtime.mjs && electron-forge package",
    "icons:brand": "node scripts/build-brand-icons.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "43.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@modelcontextprotocol/node": "^2.0.0-beta.5",
    "@modelcontextprotocol/server": "^2.0.0-beta.5",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "pi-vision-tool": "1.3.7",
    "playwright-core": "1.62.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  }
}
