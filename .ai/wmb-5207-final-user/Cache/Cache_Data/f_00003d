\n  gap: 10px;\r\n  margin-bottom: 8px;\r\n}\r\n.agents-settings-card-head h3 {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  line-height: 1.3;\r\n}\r\n.agents-settings-card-head h3 small {\r\n  margin-left: 8px;\r\n  color: var(--muted);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n.agents-settings-skill-line {\r\n  margin: 4px 0 0;\r\n  color: var(--muted-low);\r\n  font-size: 11.5px;\r\n  line-height: 1.35;\r\n}\r\n.agents-settings-cap-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n.agents-settings-cap-list li {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--surface);\r\n}\r\n.agents-settings-cap-copy {\r\n  display: grid;\r\n  gap: 2px;\r\n  min-width: 0;\r\n}\r\n.agents-settings-cap-copy strong {\r\n  color: var(--ink);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n}\r\n.agents-settings-cap-copy span,\r\n.agents-settings-empty {\r\n  margin: 0;\r\n  color: var(--muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n.agents-cap-toggle {\r\n  flex: none;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-height: 32px;\r\n  padding: 0 10px;\r\n  border-radius: 999px;\r\n  border: 1px solid color-mix(in srgb, var(--success) 35%, var(--border));\r\n  background: color-mix(in srgb, var(--success) 10%, var(--surface-raised));\r\n  color: var(--ink);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  user-select: none;\r\n}\r\n.agents-cap-toggle.off {\r\n  border-color: var(--border-strong);\r\n  background: var(--surface-raised);\r\n  color: var(--muted);\r\n}\r\n.agents-cap-toggle input {\r\n  width: 15px;\r\n  height: 15px;\r\n  accent-color: var(--accent);\r\n  cursor: pointer;\r\n}\r\n.settings-section-agent .settings-row-compact {\r\n  padding-top: 0;\r\n  padding-bottom: 12px;\r\n  align-items: start;\r\n}\r\n.settings-section-agent .settings-row-compact h3 { margin-bottom: 2px; }\r\n.settings-section-agent .settings-row-compact p { font-size: 12.5px; }\r\n.settings-mono-line {\r\n  font-family: var(--mono);\r\n  font-size: 12px !important;\r\n  color: var(--ink-soft) !important;\r\n}\r\n@media (max-width: 1100px) {\r\n  .agents-settings-controls,\r\n  .agents-settings-role-grid { grid-template-columns: 1fr; }\r\n}\r\n/* ---- 班组概览：五角色等宽高卡（整卡 button，头像居中，进度轨主导） ---- */\n.agents-overview {\n  display: grid;\n  gap: 8px;\n  min-width: 0;\n  padding: 10px;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--surface-raised);\n}\n.agents-overview-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px 12px;\n  min-height: 28px;\n}\n.agents-overview-note {\n  color: var(--muted-low);\n  font-size: 12px;\n}\n.agents-config-entry {\n  flex: none;\n  border: 1px solid var(--border-strong, var(--border));\n  background: transparent;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 650;\n  padding: 5px 12px;\n  border-radius: 999px;\n  cursor: pointer;\n}\n.agents-config-entry:hover:not(:disabled) {\n  color: var(--ink);\n  border-color: color-mix(in srgb, var(--accent) 45%, var(--border));\n}\n.agents-config-entry:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n}\n\n/* 宽屏 5 等宽；窄屏 auto-fit 自动换行（min(100%,…) 单列保底，无横向溢出）。 */\n.agents-overview-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));\n  gap: 8px;\n  align-items: stretch;\n}\n\n/* 整卡 button：无嵌套交互元素，键盘可达，暗亮主题统一。 */\n.agents-role-card {\n  display: grid;\n  align-content: center;\n  gap: 7px;\n  min-width: 0;\n  min-height: 228px;\n  padding: 12px 10px;\n  border: 1px solid var(--border-soft, var(--border));\n  border-radius: 12px;\n  background: var(--surface);\n  color: inherit;\n  font: inherit;\n  text-align: center;\n  