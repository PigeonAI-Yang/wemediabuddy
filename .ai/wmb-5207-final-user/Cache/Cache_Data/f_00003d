ar(--muted);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.agents-card-summary {\n  color: var(--muted-low);\n  font-weight: 400;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n}\n.agents-role-empty {\n  margin: 0;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n.agents-overview-loading {\n  grid-column: 1 / -1;\n  margin: 0;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n/* 活动区空态：当前无活动实例（紧凑一行，不占网格）。 */\n.agents-filter-empty {\n  margin: 0;\n  padding: 14px;\n  border: 1px dashed var(--border-strong, var(--border));\n  border-radius: 10px;\n  color: var(--muted);\n  font-size: 13px;\n  text-align: center;\n}\n\n/* 活动实例区角色节标题/计数徽标（与概览卡同页共享的既有样式）。 */\n.agents-role-title {\n  margin: 0;\n  font-size: 15px;\n  font-weight: 700;\n}\n.agents-role-count {\n  margin-left: auto;\n  min-width: 1.6em;\n  text-align: center;\n  padding: 2px 8px;\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--accent) 16%, transparent);\n  color: var(--accent-soft, var(--ink));\n  font-size: 12px;\n  font-weight: 700;\n}\r\n/* 活动实例与历史工单共用一块连续台账。 */\r\n.agents-work-ledger {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 14px;\r\n  padding: 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  background: var(--surface-raised);\r\n}\r\n\r\n/* ---- 实例卡（同角色可并列：组内 wrap 网格） ---- */\r\n.agents-instance-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));\r\n  gap: 10px;\r\n  align-items: start;\r\n}\r\n\r\n/* 同角色多实例才展开实例卡网格；单实例收窄为紧凑卡，不占满整行。 */\r\n.agents-instance-list:has(> .agents-instance-card:only-child) {\r\n  grid-template-columns: minmax(min(100%, 280px), 460px);\r\n  justify-content: start;\r\n}\r\n\r\n.agents-instance-card {\r\n  display: grid;\r\n  gap: 8px;\r\n  min-width: 0;\r\n  padding: 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  background: var(--surface);\r\n}\r\n.agents-instance-card.status-running {\r\n  box-shadow: inset 0 0 0 1px var(--agents-running-ring);\r\n}\r\n.agents-instance-card.status-needs_user {\r\n  border-color: color-mix(in srgb, var(--info) 60%, var(--border));\r\n  box-shadow: inset 0 0 0 1px var(--agents-needs-ring);\r\n  background: color-mix(in srgb, var(--info) 5%, var(--surface));\r\n}\r\n.agents-instance-card.status-failed {\r\n  border-color: color-mix(in srgb, var(--danger) 45%, var(--border));\r\n}\r\n\r\n.agents-instance-head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n.agents-instance-name {\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.agents-instance-number {\r\n  color: var(--muted);\r\n  font-weight: 650;\r\n}\r\n\r\n.agents-instance-brief {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  line-height: 1.45;\r\n  color: var(--ink);\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n.agents-instance-step {\r\n  margin: 0;\r\n  color: var(--muted);\r\n  font-size: 12px;\r\n  line-height: 1.4;\r\n}\r\n.agents-instance-detail {\r\n  margin: 0;\r\n  color: var(--ink-soft, var(--ink));\r\n  font-size: 12.5px;\r\n  line-height: 1.45;\r\n}\r\n.agents-instance-meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px 10px;\r\n  min-width: 0;\r\n}\r\n.agents-instance-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.agents-instance-progress {\r\n  display: grid;\r\n  gap: 5px;\r\n}\r\n\r\n/* ---- 历史（统一区，每角色折叠，最近 N 条终态实例；只从持久面投影） ---- */\r\n.agents-history-area {\r\n  display: grid;\r\n  gap: 8px;\r\n  min-width: 0;\r\n  padding-top: 12px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n.agents-role-history {\r\n  min-width: 0;\r\n}\r\n.agents-role-history + .agents-role-history {\r\n  border-top: 1px solid var(--border-soft, var(--border));\r\n  padding-top: 8px;\r\n}\r\n.agents-role-history summary {\r\n  cursor: pointer;\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n  color: var(--muted);\r\n  user-select: none;\r\n  padding: 2px 0;\r\n}\r\n.agents-role-history summary:hover {\r\n  color: var(--ink);\r\n}\r\n.agents-role-history summary:focus-visible {\r\n  outline: 2px solid var(--accent);\r\n  outline-offset: 2px;\r\n  border-radius: 4px;\r\n}\r\n.agents-history-list {\r\n  list-style: none;\r\n  margin: 8px 0 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n.agents-history-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px 8px;\r\n  padding: 5px 4px;\r\n  border-bottom: 1px solid var(--border-soft, var(--border));\r\n  font-size: 12px;\r\n  min-width: 0;\r\n}\r\n.agents-history-row .agents-job-status-word {\r\n  margin-left: 0;\r\n}\r\n.agents-history-time {\r\n  color: var(--muted-low);\r\n  font-variant-numeric: tabular-nums;\r\n  white-space: nowrap;\r\n}\r\n.agents-history-brief {\r\n  order: 3;\r\n  flex-basis: 100%;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  color: var(--muted);\r\n}\r\n.agents-history-actions {\r\n  margin-left: auto;\r\n  display: inline-flex;\r\n  gap: 4px;\r\n  white-space: nowrap;\r\n}\r\n/* ---- 状态点（颜色 + 文字双编码，WCAG AA；running 琥珀无脉冲） ---- */\r\n.agents-status-dot {\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 999px;\r\n  display: inline-block;\r\n  flex: 0 0 auto;\r\n  box-sizing: border-box;\r\n}\r\n.agents-status-dot.status-idle {\r\n  border: 1.5px solid var(--muted);\r\n  background: transparent;\r\n}\r\n.agents-status-dot.status-queued {\r\n  background: var(--muted);\r\n}\r\n.agents-status-dot.status-waiting_resource {\r\n  border: 1.5px dashed var(--muted);\r\n  background: transparent;\r\n}\r\n.agents-status-dot.status-running {\r\n  background: var(--status-running);\r\n}\r\n.agents-status-dot.status-needs_user {\r\n  background: var(--info);\r\n}\r\n.agents-status-dot.status-succeeded,\r\n.agents-status-dot.status-partial {\r\n  background: var(--success);\r\n}\r\n.agents-status-dot.status-failed {\r\n  background: var(--danger);\r\n}\r\n.agents-status-dot.status-blocked {\r\n  background: var(--danger);\r\n}\r\n.agents-status-dot.status-cancelled,\r\n.agents-status-dot.status-unknown {\r\n  border: 1.5px dashed var(--muted-low);\r\n  background: transparent;\r\n}\r\n\r\n/* 状态词（与状态点同源映射；无虚构空闲态） */\r\n.agents-status-word.status-running,\r\n.agents-job-status-word.status-running {\r\n  color: var(--status-running);\r\n}\r\n.agents-status-word.status-needs_user,\r\n.agents-job-status-word.status-needs_user {\r\n  color: var(--info);\r\n}\r\n.agents-status-word.status-succeeded,\r\n.agents-status-word.status-partial,\r\n.agents-job-status-word.status-succeeded,\r\n.agents-job-status-word.status-partial {\r\n  color: var(--success);\r\n}\r\n.agents-status-word.status-failed,\r\n.agents-job-status-word.status-failed {\r\n  color: var(--danger);\r\n}\r\n.agents-status-word.status-blocked {\r\n  color: var(--danger);\r\n}\r\n.agents-status-word.status-cancelled,\r\n.agents-job-status-word.status-cancelled {\r\n  color: var(--muted-low);\r\n}\r\n.agents-status-word.status-queued,\r\n.agents-status-word.status-waiting_resource,\r\n.agents-status-word.status-idle,\r\n.agents-job-status-word.status-queued,\r\n.agents-job-status-word.status-waiting_resource {\r\n  color: var(--muted);\r\n}\r\n\r\n.agents-job-status-word {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  margin-left: auto;\r\n  font-size: 12px;\r\n  font-weight: 650;\r\n  white-space: nowrap;\r\n}\r\n\r\n.agents-job-stamp {\r\n  font-variant-numeric: tabular-nums;\r\n  white-space: nowrap;\r\n  color: var(--muted);\r\n  font-size: 12px;\r\n}\r\n.agents-job-intent {\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  color: var(-