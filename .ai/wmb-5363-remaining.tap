ght: 1.25; letter-spacing: -.02em; white-space: nowrap; }\r\n.publish-room-titleline strong { color: var(--amber); font-size: 13px; font-weight: 650; }\r\n.publish-room-copy p { margin: 6px 0 0; overflow: hidden; color: var(--muted); font-size: 13px; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }\r\n.publish-room-actions { flex: none; margin-left: auto; display: flex; align-items: center; gap: 8px; }\r\n.publish-room-actions button { min-height: 36px; }\r\n.publish-room-actions .secondary-button { border-color: var(--border); background: transparent; color: var(--ink-soft); }\r\n.publish-room-actions .secondary-button:hover { background: var(--surface-hover); color: var(--ink); }\r\n\r\n/* —— 视图页签（v3 view-tab）：文字页签 + 强调下划线，无计数丸 —— */\r\n.publish-tabs {\r\n  flex: 0 0 auto;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 18px;\r\n  min-height: 42px;\r\n  margin: 0;\r\n  padding: 0 22px;\r\n  border-bottom: 1px solid var(--border-soft);\r\n}\r\n.publish-tabs .proposal-tab {\r\n  min-height: 42px;\r\n  padding: 0;\r\n  gap: 6px;\r\n  border-bottom: 2px solid transparent;\r\n  background: transparent;\r\n  color: var(--muted);\r\n  font-size: 13.5px;\r\n  font-weight: 650;\r\n}\r\n.publish-tabs .proposal-tab:hover { background: transparent; color: var(--ink); }\r\n.publish-tabs .proposal-tab.active { color: var(--ink); border-bottom-color: var(--accent); }\r\n.publish-tabs .proposal-tab:focus-visible {\r\n  outline: none;\r\n  color: var(--ink);\r\n  border-bottom-color: var(--accent);\r\n}\r\n\r\n/* —— 矩阵外框：容器驱动宽度，页面拥有垂直滚动；仅窄容器才允许横向滚动兜底 —— */\r\n.publish-matrix-wrap {\r\n  flex: 0 0 auto;\r\n  min-height: 0;\r\n  display: block;\r\n  padding: 12px;\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  container-type: inline-size;\r\n  container-name: publish-matrix;\r\n  overflow: visible;\r\n}\r\n.publish-matrix-scroller {\r\n  display: block;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  overflow-x: clip;\r\n  overflow-y: visible;\r\n  overscroll-behavior: auto;\r\n  scrollbar-gutter: auto;\r\n}\r\n\r\n/* —— 矩阵网格：内容列保留优先级，平台列可压缩至 0；基础态必须在 960px 内容纳 5 列不出横向滚动 ——\r\n   窄容器兜底由 @container 驱动，见下方 narrow-only 横向滚动段。 */\r\n.publish-matrix {\r\n  --publish-col-content: minmax(220px, 1.45fr);\r\n  --publish-col-platform: minmax(0, 1fr);\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  display: grid;\r\n  min-height: auto;\r\n  align-content: start;\r\n  overflow: clip;\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  background: var(--panel-bg);\r\n}\r\n.publish-matrix-head,\r\n.publish-matrix-row { display: grid; grid-column: 1 / -1; grid-template-columns: inherit; min-width: 0; max-width: 100%; }\r\n.publish-matrix-head > *,\r\n.publish-matrix-row > * { min-width: 0; max-width: 100%; }\r\n.publish-matrix-corner,\r\n.publish-platform-head {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 4;\r\n  min-width: 0;\r\n  min-height: 72px;\r\n  padding: 13px 16px;\r\n  border-bottom: 1px solid var(--border);\r\n  border-right: 1px solid var(--border-soft);\r\n  background: var(--panel-bg);\r\n}\r\n.publish-matrix-corner {\r\n  left: 0;\r\n  z-index: 6;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  gap: 4px;\r\n  color: var(--ink);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n}\r\n.publish-matrix-corner span { margin-top: 4px; color: var(--muted); font-size: 12px; font-weight: 400; }\r\n.publish-platform-copy { min-width: 0; max-width: 100%; overflow: hidden; }\r\n.publish-platform-copy strong { display: block; overflow: hidden; color: var(--ink); font-size: 13px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }\r\n.publish-platform-copy small { display: block; margin-top: 3px; overflow: hidden; color: var(--muted); font-size: 11.5px; text-overflow: ellipsis; white-space: nowrap; }\r\n.publish-platform-head .platform-mar