ght: 1.25; letter-spacing: -.02em; white-space: nowrap; }\r\n.publish-room-titleline strong { color: var(--amber); font-size: 13px; font-weight: 650; }\r\n.publish-room-copy p { margin: 6px 0 0; overflow: hidden; color: var(--muted); font-size: 13px; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }\r\n.publish-room-actions { flex: none; margin-left: auto; display: flex; align-items: center; gap: 8px; }\r\n.publish-room-actions button { min-height: 36px; }\r\n.publish-room-actions .secondary-button { border-color: var(--border); background: transparent; color: var(--ink-soft); }\r\n.publish-room-actions .secondary-button:hover { background: var(--surface-hover); color: var(--ink); }\r\n\r\n/* —— 视图页签（v3 view-tab）：文字页签 + 强调下划线，无计数丸 —— */\r\n.publish-tabs {\r\n  flex: 0 0 auto;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 18px;\r\n  min-height: 42px;\r\n  margin: 0;\r\n  padding: 0 22px;\r\n  border-bottom: 1px solid var(--border-soft);\r\n}\r\n.publish-tabs .proposal-tab {\r\n  min-height: 42px;\r\n  padding: 0;\r\n  gap: 6px;\r\n  border-bottom: 2px solid transparent;\r\n  background: transparent;\r\n  color: var(--muted);\r\n  font-size: 13.5px;\r\n  font-weight: 650;\r\n}\r\n.publish-tabs .proposal-tab:hover { background: transparent; color: var(--ink); }\r\n.publish-tabs .proposal-tab.active { color: var(--ink); border-bottom-color: var(--accent); }\r\n.publish-tabs .proposal-tab:focus-visible {\r\n  outline: none;\r\n  color: var(--ink);\r\n  border-bottom-color: var(--accent);\r\n}\r\n\r\n/* —— 矩阵外框：容器驱动宽度，页面拥有垂直滚动；仅窄容器才允许横向滚动兜底 —— */\r\n.publish-matrix-wrap {\r\n  flex: 0 0 auto;\r\n  min-height: 0;\r\n  display: block;\r\n  padding: 12px;\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r\n  container-type: inline-size;\r\n  container-name: publish-matrix;\r\n  overflow: visible;\r\n}\r\n.publish-matrix-scroller {\r\n  display: block;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-width: 0;\r