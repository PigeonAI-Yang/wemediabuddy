    '  const sourcesAreToday = today?.sourcesDate === planDate;\r\n' +
    '  const todaySourcesTotal = sourcesAreToday ? (today?.sourcesTotal ?? sources.length) : 0;\r\n' +
    '  const scoringPendingCount = (todayPlan?.items ?? []).filter((item) => isScoringPendingItem(item)).length;\r\n' +
