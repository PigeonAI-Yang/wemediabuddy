alf > feed.clientHeight + 8) {\r\n        const dt = Math.min(0.05, (now - last) / 1000);\r\n        offset += speed * dt;\r\n        if (offset >= half) offset -= half;\r\n        track.style.transform = `translate3d(0, ${-offset}px, 0)`;\r\n      }\r\n      last = now;\r\n      raf = requestAnimationFrame(tickFrame);\r\n    };\r\n    raf = requestAnimationFrame(tickFrame);\r\n\r\n    return () => {"... 26555 more characters,
