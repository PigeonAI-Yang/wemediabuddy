    "  | 'page_library' | 'page_canvas' | 'page_studio' | 'page_publish' | 'page_results';\r\n" +
    "export type RunnerAgentIntent = 'daily_intelligence' | 'daily_scan' | 'daily_judge' | 'studio_draft' | 'results_review' | 'research';\r\n" +
    'export type AgentIntent = RunnerAgentIntent | PageAgentIntent;\r\n' +
    "export type AgentTaskStatus = 'running' | 'succeeded' | 'partial' | 'failed' | 'cancelled' | 'interrupted' | 'needs_user';\r\n" +
    "export type AgentTaskControl = 'skip_source' | 'save_partial' | 'cancel';\r\n" +
    'export type AgentTaskProgress = {\r\n' +
    '  currentSource?: string;\r\n' +
    '  planned?: number;\r\n' +
    '  processed?: number;\r\n' +
    '  failed?: number;\r\n' +
    '  verified?: number;\r\n' +
    '  saved?: number;\r\n' +
    '  opportunityCount?: number;\r\n' +
    '  /** Manager 简报/流水摘要：持久化 progress JSON 可携带（manager-dispatch/dock 读取）。 */\r\n' +
    '  message?: string;\r\n' +
    '  /** Pi 流式输出最近活动时间：长流式输出防 stall 误判（daily-control 读取）。 */\r\n' +
    '  streamActivityAt?: string;\r\n' +
    '  lastActivityAt?: string;\r\n' +
    '};\r\n' +
    "export type AgentTaskEvent = { at: string; message: string; level?: 'info' | 'warning' };\r\n" +
    'export type DailyReceiptAggregation = {\r\n' +
    "  status: 'succeeded' | 'partial' | 'needs_user' | 'failed';\r\n" +
    '  receipts: SourceScanReceipt[];\r\n' +
    '  missingReceiptCount: number;\r\n' +
    '};\r\n' +
    '\r\n' +
    'export const dailyAgentSessionId = (businessDate: string, taskId: string): string => `daily-${businessDate}-${taskId}`;\r\n' +
    '\r\n' +
    'export type AgentTask = {\r\n' +
    '  id: string;\r\n' +
    '  intent: AgentIntent;\r\n' +
    '  businessDate: string;\r\n' +
    '  status: AgentTaskStatus;\r\n' +
    '  phase: string;\r\n' +
    '  piSessionId: string | null;\r\n' +
    '  contextRefs: Record<string, unknown>;\r\n' +
    '  resultRefs: Record<string, unknown>;\r\n' +
    '  progress: AgentTaskProgress;\r\n' +
    '  checkpoint: Record<string, unknown>;\r\n' +
    '  events: AgentTaskEvent[];\r\n' +
    '  controlAction: AgentTaskControl | null;\r\n' +
    '  heartbeatAt: string | null;\r\n' +
    '  errorCode: string | null;\r\n' +
    '  errorMessage: string | null;\r\n' +
    '  createdAt: string;\r\n' +
    '  updatedAt: string;\r\n' +
    '  finishedAt: string | null;\r\n' +
    '};\r\n' +
    '\r\n' +
    'type AgentTaskRow = {\r\n' +
    '  id: string;\r\n' +
    '  intent: AgentIntent;\r\n' +
    '  business_date: string;\r\n' +
    '  status: AgentTaskStatus;\r\n' +
    '  phase: string;\r\n' +
    '  pi_session_id: string | null;\r\n' +
    '  context_refs_json: string;\r\n' +
    '  result_refs_json: string;\r\n' +
    '  progress_json: string;\r\n' +
    '  checkpoint_json: string;\r\n' +
    '  events_json: string;\r\n' +
    '  control_action: AgentTaskControl | null;\r\n' +
    '  heartbeat_at: string | null;\r\n' +
    '  error_code: string | null;\r\n' +
    '  error_message: string | null;\r\n' +
    '  created_at: string;\r\n' +
    '  updated_at: string;\r\n' +
    '  finished_at: string | null;\r\n' +
    '};\r\n' +
    '\r\n' +
    'const intents: AgentIntent[] = [\r\n' +
    "  'daily_intelligence', 'daily_scan', 'daily_judge', 'studio_draft', 'results_review', 'research',\r\n" +
    "  'page_today', 'page_agents', 'page_discover', 'page_proposals', 'page_topic',\r\n" +
    "  'page_library', 'page_canvas', 'page_studio', 'page_publish', 'page_results'\r\n" +
    '];\r\n' +
    'export function isPageAgentIntent(intent: string): intent is PageAgentIntent {\r\n' +
    "  return intent.startsWith('page_');\r\n" +
    '}\r\n' +
    '\r\n' +
    'export function isDailyIntelligenceFamily(intent: string): boolean {\r\n' +
    "  return intent === 'daily_intelligence' || intent === 'daily_scan' || intent === 'daily_judge';\r\n" +
    '}\r\n' +
    '\r\n' +
    '/** Prefer running daily_* task for a business date (scan or judge or legacy). */\r\n' +
    'export function getActiveDailyIntelligenceTask(database: DatabaseSync, businessDate: string): AgentTask | null {\r\n' +
    "  for (const intent of ['daily_scan', 'daily_judge', 'daily_intelligence'] as const) {\r\n" +
    '    const hit = getActiveAgentTask(database, intent, businessDate);\r\n' +
    '    if (hit) return hit;\r\n' +
    '  }\r\n' +
    '  return null;\r\n' +
    '}\r\n' +
    '\r\n' +
    'export function getLatestDailyIntelligenceTask(database: DatabaseSync, businessDate?: string): AgentTask | null {\r\n' +
    '  // 同一业务日可能有多条 scan/judge：不能只按 updatedAt，否则「成功后又取消」会盖住已交付方案。\r\n' +
    "  const intents = ['daily_scan', 'daily_judge', 'daily_intelligence'] as const;\r\n" +
    '  const rows: AgentTask[] = [];\r\n' +
    '  for (const intent of intents) {\r\n' +
    '    const list = businessDate\r\n' +
    '      ? database.prepare(\r\n' +
    '          `SELECT id FROM agent_tasks WHERE intent = ? AND business_date = ? ORDER BY updated_at DESC LIMIT 8`\r\n' +
    '        ).all(intent, businessDate) as Array<{ id: string }>\r\n' +
    '      : database.prepare(\r\n' +
    '          `SELECT id FROM agent_tasks WHERE intent = ? ORDER BY updated_at DESC LIMIT 8`\r\n' +
    '        ).all(intent) as Array<{ id: string }>;\r\n' +
    '    for (const row of list) {\r\n' +
    '      const task = getAgentTask(database, row.id);\r\n' +
    '      if (task) rows.push(task);\r\n' +
    '    }\r\n' +
    '  }\r\n' +
    '  if (!rows.length) return null;\r\n' +
    '  const rank = (status: string): number => {\r\n' +
    "    if (status === 'running') return 0;\r\n" +
    "    if (status === 'needs_user') return 1;\r\n" +
    "    if (status === 'succeeded' || status === 'completed') return 2;\r\n" +
    "    if (status === 'partial') return 3;\r\n" +
    "    if (status === 'failed' || status === 'interrupted') return 4;\r\n" +
    "    if (status === 'cancelled') return 5;\r\n" +
    '    return 6;\r\n' +
    '  };\r\n' +
    '  return rows.sort((a, b) => {\r\n' +
    '    const dr = rank(a.status) - rank(b.status);\r\n' +
    '    if (dr !== 0) return dr;\r\n' +
    '    return a.updatedAt < b.updatedAt ? 1 : -1;\r\n' +
    '  })[0] ?? null;\r\n' +
    '}\r\n' +
    '\r\n' +
    '/** 读取主管任务启动后最新创建的扫判子任务，包含已结束任务，用于恢复漏写的终态 checkpoint。 */\r\n' +
    'export function getLatestDailyIntelligenceTaskSince(database: DatabaseSync, businessDate: string, createdAt: string): AgentTask | null {\r\n' +
    '  const row = database.prepare(\r\n' +
    '    `SELECT id FROM agent_tasks\r\n' +
    "     WHERE intent IN ('daily_scan', 'daily_judge', 'daily_intelligence')\r\n" +
    '       AND business_date = ? AND created_at >= ?\r\n' +
    '     ORDER BY created_at DESC, updated_at DESC LIMIT 1`\r\n' +
    '  ).get(businessDate, createdAt) as { id?: string } | undefined;\r\n' +
    '  return row?.id ? getAgentTask(database, row.id) : null;\r\n' +
    '}\r\n' +
    '\r\n' +
    'function parseTask(row: AgentTaskRow): AgentTask {\r\n' +
    '  return {\r\n' +
    '    id: row.id,\r\n' +
    '    intent: row.intent,\r\n' +
    '    businessDate: row.business_date,\r\n' +
    '    status: row.status,\r\n' +
    '    phase: row.phase,\r\n' +
    '    piSessionId: row.pi_session_id,\r\n' +
    '    contextRefs: JSON.parse(row.context_refs_json) as Record<string, unknown>,\r\n' +
    '    resultRefs: JSON.parse(row.result_refs_json) as Record<string, unknown>,\r\n' +
    '    progress: JSON.parse(row.progress_json) as AgentTaskProgress,\r\n' +
    '    checkpoint: JSON.parse(row.checkpoint_json) as Record<string, unknown>,\r\n' +
    '    events: JSON.parse(row.events_json) as AgentTaskEvent[],\r\n' +
    '    controlAction: row.control_action,\r\n' +
    '    heartbeatAt: row.heartbeat_at,\r\n' +
    '    errorCode: row.error_code,\r\n' +
    '    errorMessage: row.error_message,\r\n' +
    '    createdAt: row.created_at,\r\n' +
    '    updatedAt: row.updated_at,\r\n' +
    '    finishedAt: row.finished_at\r\n' +
    '  };\r\n' +
    '}\r\n' +
    '\r\n' +
    'function getRow(database: DatabaseSync, id: string): AgentTaskRow | undefined {\r\n' +
    '  return database.prepare(`SELECT * FROM agent_tasks WHERE id = ?`).get(id) as AgentTaskRow | undefined;\r\n' +
    '}\r\n' +
    '\r\n' +
    'export function agentRequestId(taskId: string, logicalStep: string): string {\r\n' +
    '  return `${taskId}:${logicalStep}`;\r\n' +
    '}\r\n' +
    '\r\n' +
    'export function getAgentTask(database: DatabaseSync, id: string): AgentTask | null {\r\n' +
    '  const row = getRow(database, id);\r\n' +
    '  return row ? parseTask(row) : null;\r\n' +
    '}\r\n' +
    '\r\n' +
    '\r\n' +
    'function requireTask(database: DatabaseSync, id: string): AgentTask {\r\n' +
    '  const task = getAgentTask(database, id);\r\n' +
    '  if (!task) throw new Error(`Agent 任务不存在：${id}`);\r\n' +
    '  return task;\r\n' +
    '}\r\n' +
    'export function getActiveAgentTask(database: DatabaseSync, intent: AgentIntent, businessDate: string, roleId?: string | null): AgentTask | null {\r\n' +
    '  // WMB-5185：可选 roleId 选择器——page_* 任务按 (intent, businessDate, contextRefs.roleId) 幂等复用，\r\n' +
    '  // 使页 dock（desk）与员工工单（writer/librarian/...）同页同日期并存时互不复用对方任务。\r\n' +
    '  const roleFilter = roleId?.trim() || null;\r\n' +
    '  const row = database.prepare(`SELECT * FROM agent_tasks\r\n' +
    "    WHERE intent = ? AND business_date = ? AND status = 'running'\r\n" +
    "      AND (? IS NULL OR json_extract(context_refs_json, '$.roleId') = ?)\r\n" +
    '    ORDER BY created_at DESC LIMIT 1`).get(intent, businessDate, roleFilter, roleFilter) as AgentTaskRow | undefined;\r\n' +
    '  return row ? parseTask(row) : null;\r\n' +
    '}\r\n' +
    '\r\n' +
    'export function getLatestAgentTask(database: DatabaseSync, intent?: AgentIntent, businessDate?: string): AgentTask | null {\r\n' +
    '  if (intent && businessDate) {\r\n' +
    '    const row = database.prepare(`SELECT * FROM agent_tasks\r\n' +
    '      WHERE intent = ? AND business_date = ? ORDER BY created_at DESC LIMIT 1`).get(intent, businessDate) as AgentTaskRow | undefined;\r\n' +
    '    return row ? parseTask(row) : null;\r\n' +
    '  }\r\n' +
    '  if (intent) {\r\n' +
    '    const row = database.prepare(`SELECT * FROM agent_tasks\r\n' +
    '      WHERE intent = ? ORDER BY created_at DESC LIMIT 1`).get(intent) as AgentTaskRow | undefined;\r\n' +
    '    return row ? parseTask(row) : null;\r\n' +
    '  }\r\n' +
    '  const row = database.prepare(`SELECT * FROM agent_tasks\r\n' +
    '    ORDER BY created_at DESC LIMIT 1`).get() as AgentTaskRow | undefined;\r\n' +
    '  return row ? parseTask(row) : null;\r\n' +
    '}\r\n' +
    '\r\n' +
    '/**\r\n' +
    ' * 最近一次成功写入的增量判断水印。水印存于各任务 checkpoint，但判断任务往往是一轮一个新任务，\r\n' +
    ' * 跨任务读取最近一次水印才能让"只评新资料"在滚动流程中真正生效（评审 N1 修复）。\r\n' +
    ' */\r\n' +
    'export function readLatestJudgeWatermark(database: DatabaseSync): string | null {\r\n' +
