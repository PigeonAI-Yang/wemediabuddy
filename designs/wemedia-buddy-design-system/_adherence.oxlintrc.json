{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|size|onRequestClose|children|footer|className|ariaDescription|closeOnBackdrop|closeOnEscape|role|initialFocusRef|key|ref|style)$/]",
        "message": "<AppModal> doesn't accept that prop. Declared props: open, title, size, onRequestClose, children, footer, className, ariaDescription, closeOnBackdrop, closeOnEscape, role, initialFocusRef."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppModal'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:confirm|standard|large|fullscreen)$/]",
        "message": "<AppModal> size must be one of 'confirm' | 'standard' | 'large' | 'fullscreen'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppModal'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:dialog|alertdialog)$/]",
        "message": "<AppModal> role must be one of 'dialog' | 'alertdialog'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|type|disabled|className|children|onClick|ariaLabel|title|key|ref|style)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, type, disabled, className, children, onClick, ariaLabel, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChipFilter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|pressed|count|size|disabled|className|onToggle|title|key|ref|style|children)$/]",
        "message": "<ChipFilter> doesn't accept that prop. Declared props: label, pressed, count, size, disabled, className, onToggle, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChipFilter'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<ChipFilter> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|htmlFor|id|required|error|helper|className|children|key|ref|style)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, htmlFor, id, required, error, helper, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|variant|disabled|className|children|onClick|title|key|ref|style)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, size, variant, disabled, className, children, onClick, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<IconButton> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|ghost|danger)$/]",
        "message": "<IconButton> variant must be one of 'default' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageCommand'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|summary|stats|actions|className|key|ref|style|children)$/]",
        "message": "<PageCommand> doesn't accept that prop. Declared props: title, summary, stats, actions, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:labelZh|roomZh|status|word|percent|indeterminate|summary|avatar|expanded|isDesk|className|onOpen|key|ref|style|children)$/]",
        "message": "<RoleCard> doesn't accept that prop. Declared props: labelZh, roomZh, status, word, percent, indeterminate, summary, avatar, expanded, isDesk, className, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:idle|running|needs-user|ok|bad)$/]",
        "message": "<RoleCard> status must be one of 'idle' | 'running' | 'needs-user' | 'ok' | 'bad'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatePanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|title|body|action|onClick|icon|minHeight|className|children|key|ref|style)$/]",
        "message": "<StatePanel> doesn't accept that prop. Declared props: state, title, body, action, onClick, icon, minHeight, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatePanel'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:loading|error|empty|content)$/]",
        "message": "<StatePanel> state must be one of 'loading' | 'error' | 'empty' | 'content'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|live|className|key|ref|style)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: tone, children, live, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:idle|ok|warn|needs-user|bad|active)$/]",
        "message": "<StatusPill> tone must be one of 'idle' | 'ok' | 'warn' | 'needs-user' | 'bad' | 'active'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabList'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|selectedId|onSelect|ariaLabel|className|key|ref|style|children)$/]",
        "message": "<TabList> doesn't accept that prop. Declared props: tabs, selectedId, onSelect, ariaLabel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='WmbCreatureMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|className|key|ref|style|children)$/]",
        "message": "<WmbCreatureMark> doesn't accept that prop. Declared props: state, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='WmbCreatureMark'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|connect|working|settling|sleep|scout)$/]",
        "message": "<WmbCreatureMark> state must be one of 'idle' | 'connect' | 'working' | 'settling' | 'sleep' | 'scout'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
